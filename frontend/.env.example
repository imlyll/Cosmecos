# Leave empty in development: Vite proxies /api and /uploads to the backend.
VITE_API_URL=
# Backend origin used by the dev proxy
VITE_PROXY_TARGET=http://localhost:5000
# Optional promo video (mp4 URL) shown from the play button on the home page
VITE_PROMO_VIDEO_URL=
# "Sign in with Google": same OAuth client id as GOOGLE_CLIENT_ID in the backend. Empty hides the button.
VITE_GOOGLE_CLIENT_ID=
