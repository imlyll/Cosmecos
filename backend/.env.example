NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cosmecos

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Optional: when all three are set, images go to Cloudinary; otherwise they are stored in ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Login/register attempts per IP per 15 min (default: 20 in production, 200 otherwise)
AUTH_RATE_LIMIT=

# Order pricing
FREE_SHIPPING_THRESHOLD=100
SHIPPING_FEE=9.99
TAX_RATE=0

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@cosmecos.com
SEED_ADMIN_PASSWORD=Admin123!
