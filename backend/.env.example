NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cosmecos

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Optional: when all three are set, images go to Cloudinary; otherwise they are stored in ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Login/register attempts per IP per 15 min (default: 20 in production, 200 otherwise)
AUTH_RATE_LIMIT=

# Email (registration OTP codes) via SMTP, e.g. Gmail:
#   SMTP_PASS must be a Gmail App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
#   Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses SSL (SMTP_SECURE=true).
# EMAIL_USER / EMAIL_PASS work too and imply smtp.gmail.com.
# Without credentials, development prints the emails (and codes) to the console instead.
# Check delivery with: npm run mail:check -- you@example.com
# Brevo HTTP API (https://app.brevo.com → SMTP & API → API Keys). When set, it is used instead of SMTP:
# use it on hosts that block SMTP ports (e.g. Render's free plan). MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_digit_app_password
# Defaults to "Cosmecos <SMTP_USER>". Gmail sends as SMTP_USER unless this address is a verified
# "Send mail as" alias (Gmail → Settings → Accounts); the server logs a warning at startup if not.
MAIL_FROM="Cosmecos <cosmecos@protonmail.com>"

# Verification code lifetime, resend cooldown and wrong-guess limit
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Order pricing
FREE_SHIPPING_THRESHOLD=100
SHIPPING_FEE=9.99
TAX_RATE=0

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@cosmecos.com
SEED_ADMIN_PASSWORD=Admin123!
